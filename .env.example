# ============================================================
# CivicFix AI — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_ENV=development
APP_NAME=CivicFix AI
APP_VERSION=1.0.0
DEBUG=true

# ─── Database ───────────────────────────────────────────────
# SQLite (default — zero-config local development)
DATABASE_URL=sqlite:///./civicfix.db
DATABASE_MODE=sqlite
POSTGRES_USER=civicfix
POSTGRES_PASSWORD=

# PostgreSQL + PostGIS (production)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/civicfix
# DATABASE_MODE=postgresql

# ─── Security ───────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── AI Provider ────────────────────────────────────────────
# Options: mock | groq | openai | gemini
AI_PROVIDER=mock
AI_MODE=mock

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MCP Servers ────────────────────────────────────────────
# Options: mock | local | remote
MCP_MODE=mock
MCP_MAPS_URL=http://localhost:8010
MCP_CIVIC_URL=http://localhost:8011
MCP_NOTIFICATION_URL=http://localhost:8012
MCP_POLICY_URL=http://localhost:8013
MCP_ANALYTICS_URL=http://localhost:8014

# ─── Maps / GIS ─────────────────────────────────────────────
MAPS_API_KEY=
GEOCODING_PROVIDER=mock

# ─── Email ──────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@civicfix.ai

# ─── SMS (Mock/Demo) ────────────────────────────────────────
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── File Storage ───────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
SLA_SCAN_INTERVAL_SECONDS=300

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
